# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube al repo (está en .gitignore).

# Token de GitHub para la ingesta. Sin token, GitHub permite 60 peticiones por hora.
GITHUB_TOKEN=

# Clave del proveedor de LLM (IA). Se completa cuando se elija el modelo.
LLM_API_KEY=

# Conexión a PostgreSQL. Se completa cuando exista el docker-compose.
DATABASE_URL=
